# i3 config file (v4)
#
# This file only holds variables that must be defined before the included
# files that use them, plus the include directives themselves. All other
# settings live in config.d/ — see i3 User's Guide §4.1 (Include directive):
# https://i3wm.org/docs/userguide.html#include
# Full reference: https://i3wm.org/docs/userguide.html

# The modifier key used throughout every keybinding. Set here (rather than
# inside config.d/) because nearly every included file depends on it, and
# i3 requires a variable to be defined before it is used (§4.1, §4.16).
set $mod Mod4
set $term kitty

include config.d/00-general.conf
include config.d/10-startup.conf
include config.d/20-workspaces.conf
include config.d/30-bindings.conf
include config.d/40-rules.conf
include config.d/50-bar.conf
